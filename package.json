{
  "name": "idoconverter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:migrate:dry": "node scripts/db-migrate.mjs --dry-run",
    "db:verify": "node scripts/db-verify.mjs",
    "db:seed": "node scripts/db-seed.mjs",
    "leads:export": "node scripts/leads-export.mjs",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "test:all": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "mysql2": "3.24.5",
    "next": "15.5.27",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}