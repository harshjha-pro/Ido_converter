# Copy to .env.local for local development. Never commit real values.
# See docs/ENVIRONMENT_CONFIGURATION.md.

# MySQL connection (Hostinger: host is usually localhost). Leave empty to run without sign-ups/statistics.
DATABASE_URL=
# 32+ random characters: openssl rand -hex 32
IP_HASH_SECRET=
# Your site's exact origin, e.g. https://idoconverter.com
APP_ORIGIN=
# Optional
DB_POOL_SIZE=3
CLIENT_IP_HEADER=x-forwarded-for
# Canonical site URL (built into pages; set before building)
NEXT_PUBLIC_SITE_URL=https://idoconverter.com
# Public WhatsApp number (digits with country code). Set before building.
NEXT_PUBLIC_WHATSAPP_NUMBER=
