---
import Layout from './Layout.astro';

interface Props {
  title: string;
  /** Legal pages are drafts until a lawyer or CA reviews them (NOTES.md open question 6). */
  draft?: boolean;
  updated?: string;
}

const { title, draft = true, updated = '2026-10-02' } = Astro.props;
---

<Layout title={title}>
  <article class="legal">
    <h1>{title}</h1>
    <p class="legal-meta">Last updated {updated}</p>
    {draft && (
      <p class="legal-draft"><strong>Draft.</strong> This page has not yet been reviewed by a lawyer or CA and is not final wording.</p>
    )}
    <slot />
  </article>
</Layout>

<style>
  .legal {
    max-width: 720px;
    margin: 0 auto;
  }
  .legal h1 {
    font-size: var(--text-h1);
    color: var(--color-bg-dark);
    margin-bottom: var(--space-2);
  }
  .legal-meta {
    color: var(--color-text-muted);
    font-size: var(--text-small);
    margin-bottom: var(--space-4);
  }
  .legal-draft {
    border-left: 4px solid var(--color-accent-yellow);
    background: var(--color-card-bg);
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-small);
  }
  .legal :global(h2) {
    font-size: var(--text-h3);
    color: var(--color-bg-dark);
    margin-top: var(--space-5);
  }
  .legal :global(p), .legal :global(li) {
    line-height: 1.7;
  }
  .legal :global(ul) {
    padding-left: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .legal :global(a) {
    text-decoration: underline;
  }
</style>
