---
import Layout from './Layout.astro';

interface Props {
  title: string;
  howTo: string;
  faq: { q: string; a: string }[];
  relatedTools: { title: string; url?: string }[];
}

const { title, howTo, faq, relatedTools } = Astro.props;

// Helper to wrap the last word of the title in the serif font for stylistic emphasis
const titleParts = title.split(' ');
const lastWord = titleParts.pop();
const firstPart = titleParts.join(' ');
---

<Layout title={title}>
  <div class="tool-header">
    <div class="title-lockup">
      <h1>{firstPart} <span class="font-serif-italic">{lastWord}</span></h1>
      <div class="privacy-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Runs in your browser. Nothing is uploaded.</span>
      </div>
    </div>
  </div>
  
  <div class="tool-area">
    <slot />
  </div>
  
  <div class="tool-meta">
    <section class="meta-section">
      <h2>How to use</h2>
      <p>{howTo}</p>
    </section>
    
    {faq && faq.length > 0 && (
      <section class="meta-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
          {faq.map((item) => (
            <details class="faq-item">
              <summary class="faq-question">
                {item.q}
                <svg class="faq-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </summary>
              <div class="faq-answer">
                <p>{item.a}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}
    
    {relatedTools && relatedTools.length > 0 && (
      <section class="meta-section">
        <h2>Related Tools</h2>
        <ul class="related-list">
          {relatedTools.map((tool) => (
            <li>
              {tool.url
                ? <a href={tool.url}>{tool.title} &rarr;</a>
                : <span class="related-soon">{tool.title} <em>(coming soon)</em></span>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

<style>
  .tool-header {
    margin-bottom: var(--space-6);
  }
  
  .title-lockup {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  
  @media (min-width: 768px) {
    .title-lockup {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  
  .title-lockup h1 {
    font-size: 2.5rem;
    margin-bottom: 0;
    color: var(--color-bg-dark);
    letter-spacing: -0.02em;
  }
  
  .privacy-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-bg-dark);
    background-color: var(--color-accent-yellow);
    padding: var(--space-2) var(--space-4);
    border-radius: 9999px;
  }
  
  .tool-area {
    background-color: var(--color-card-bg);
    border-radius: 24px;
    padding: var(--space-3);
    margin-bottom: var(--space-7);
    min-height: 400px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.04);
    border: 1px solid rgba(0,0,0,0.05);
  }
  

  @media (min-width: 600px) {
    .tool-area { padding: var(--space-6); }
  }

  .tool-meta {
    max-width: 800px;
    margin: 0 auto;
  }

  .meta-section {
    margin-bottom: var(--space-7);
  }
  
  .meta-section h2 {
    font-size: var(--text-h2);
    color: var(--color-bg-dark);
    margin-bottom: var(--space-4);
  }
  
  .meta-section p {
    color: var(--color-text-muted);
    font-size: var(--text-body);
  }

  /* Zero-dependency FAQ using details/summary */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .faq-item {
    background-color: var(--color-card-bg);
    border-radius: 12px;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  
  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-4);
    font-weight: 600;
    font-size: var(--text-body);
    color: var(--color-bg-dark);
    cursor: pointer;
    list-style: none; /* Hide default arrow */
    user-select: none;
  }
  
  /* Hide default details marker in webkit */
  .faq-question::-webkit-details-marker {
    display: none;
  }
  
  .faq-icon {
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-left: var(--space-3);
  }
  
  details[open] .faq-icon {
    transform: rotate(180deg);
  }
  
  .faq-answer {
    padding: 0 var(--space-4) var(--space-4) var(--space-4);
  }
  
  .faq-answer p {
    margin: 0;
  }
  
  .related-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .related-list a {
    display: inline-block;
    font-weight: 500;
    color: var(--color-bg-dark);
    padding: var(--space-3) var(--space-4);
    background-color: var(--color-card-bg);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }
  
  .related-soon {
    display: inline-block;
    color: var(--color-text-muted);
    padding: var(--space-3) var(--space-4);
  }

  .related-list a:hover {
    border-color: var(--color-bg-dark);
  }
</style>

<style is:global>
  /* Shared tool UI: every tool page uses these so all tools look the same */
  .tool-ui {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .panels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  @media (min-width: 900px) {
    .panels { grid-template-columns: 2fr 1fr 2fr; }
    .panels.two-col { grid-template-columns: 1fr 1fr; }
  }
  .panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
  }
  .panel-label {
    font-weight: 600;
    color: var(--color-bg-dark);
    font-size: var(--text-small);
  }
  .io-area {
    width: 100%;
    height: 400px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--text-small);
    resize: vertical;
    background: var(--color-card-bg);
    color: var(--color-bg-dark);
  }
  .io-area.short { height: 200px; }
  .controls-panel {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .options-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-small);
    border: 0;
    margin: 0;
    padding: 0;
  }
  .options-group > strong, .options-group > legend {
    color: var(--color-bg-dark);
    font-weight: 600;
    padding: 0;
  }
  .text-input, .keys-input, .style-select {
    width: 100%;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-family: inherit;
    font-size: var(--text-body);
    background: var(--color-card-bg);
    color: var(--color-text-main);
  }
  .field-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-3);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--color-bg-dark);
  }
  .options-group-inline {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    font-size: var(--text-small);
  }
  .panel-header > span {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .btn-run { width: 100%; }
  .status-area {
    font-size: var(--text-small);
    text-align: center;
    font-weight: 600;
    min-height: 1.5em;
  }
  .status-area.success { color: var(--color-accent-green-text); }
  .status-area.error { color: var(--color-error); }
  .tool-warning {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-left: 4px solid var(--color-accent-yellow);
    background: var(--color-bg-cream);
    font-size: var(--text-small);
    color: var(--color-text-main);
  }
  .findings-list {
    margin: 0;
    padding-left: var(--space-4);
    font-size: var(--text-small);
  }
  .result-box {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: var(--space-3);
  }
  .big-number {
    font-size: var(--text-h2);
    font-weight: 600;
    color: var(--color-bg-dark);
    margin: var(--space-2) 0;
  }
  .result-detail {
    font-size: var(--text-small);
    color: var(--color-text-main);
    margin-bottom: var(--space-2);
  }
  .field-hint {
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .result-list {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-3);
    font-size: var(--text-small);
  }
  .result-list dt { color: var(--color-text-main); }
  .result-list dd { margin: 0; font-weight: 600; text-align: right; color: var(--color-bg-dark); }
  .formula-details { margin-bottom: var(--space-3); font-size: var(--text-small); }
  .formula-details summary { cursor: pointer; font-weight: 600; margin-bottom: var(--space-2); }
  .formula-details .findings-list { padding-left: 0; list-style: none; display: grid; gap: var(--space-2); }
  .formula {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: var(--text-small);
    background: var(--color-bg-cream);
    padding: var(--space-2) var(--space-3);
    border-radius: 8px;
    overflow-x: auto;
  }
</style>
