---
---
<header class="header">
  <div class="container header-inner">
    <a href="/" class="logo">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="logo-icon">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
      </svg>
      idoconverter
    </a>
    
    <nav aria-label="Main Navigation" class="main-nav desktop-only">
      <ul class="nav-links">
        <li>
          <a href="/developers" class="nav-item-with-icon">
            Tools
          </a>
        </li>
        <li>
          <a href="/#professions" class="nav-item-with-icon">
            Professionals
          </a>
        </li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="nav-right">
      <a href="/developers" class="btn-primary btn-sm">Explore Tools &rarr;</a>
    </div>
  </div>
</header>

<style>
  .header {
    background-color: transparent;
    padding: var(--space-4) 0;
  }
  
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--color-bg-dark);
    text-decoration: none;
    letter-spacing: -0.03em;
  }
  
  .logo-icon {
    color: var(--color-accent-green);
    fill: rgba(47, 143, 82, 0.2);
  }
  
  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  
  
  
  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-5);
    align-items: center;
  }
  
  .nav-links a {
    color: var(--color-text-main);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    display: flex;
    align-items: center;
  }
  
  .nav-item-with-icon {
    gap: 4px;
  }
  
  .nav-links a:hover {
    color: var(--color-accent-green-text);
  }
  
  .btn-sm {
    padding: 0.5rem 1.25rem;
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .desktop-only {
      display: none;
    }
  }
  
  @media (max-width: 400px) {
    .header-inner {
      flex-direction: column;
      gap: var(--space-4);
    }
    .nav-right {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
