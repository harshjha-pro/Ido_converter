---
import { TOOLS, toolUrl } from '../data/tools';
const popular = TOOLS.filter(t => t.profession === 'developers');
---
<footer class="footer">
  <div class="container footer-inner">
    
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="logo">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-green)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="logo-icon">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          idoconverter
        </a>
        <p class="brand-tagline"><strong>Tools made to fit your task.</strong></p>
        <p class="brand-desc">Small, focused tools for developers, online sellers, job seekers, exam applicants and more. Runs in your browser. Your data never leaves your device.</p>
        
        <div class="social-links">
          <a href="#" aria-label="X (Twitter)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4l11.73 16h5L9 4H4z"></path></svg></a>
          <a href="#" aria-label="YouTube"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg></a>
          <a href="#" aria-label="LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg></a>
          <a href="#" aria-label="GitHub"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg></a>
        </div>
      </div>
      
      <div class="footer-col">
        <h3 class="col-title">Tools by profession</h3>
        <ul class="col-links">
          <li><a href="/developers"><svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg> Developers</a></li>
          <li><a href="/sellers"><svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path></svg> Online sellers</a></li>
          <li><a href="/jobseekers"><svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg> Job seekers</a></li>
          <li><a href="/forms"><svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg> Exam/form applicants</a></li>
          <li><a href="/ca" class="disabled"><svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect></svg> CAs and accountants <span class="badge">Coming soon</span></a></li>
          <li><a href="/frontend" class="disabled"><svg class="link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg> Frontend developers <span class="badge">Coming soon</span></a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Popular tools</h3>
        <ul class="col-links">
          {popular.map((t) => (
            <li>{t.live ? <a href={toolUrl(t)}>{t.title}</a> : <span class="soon-link">{t.title}</span>}</li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Company</h3>
        <ul class="col-links">
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Use</a></li>
          <li><a href="/disclaimer">Disclaimer</a></li>
          <li><a href="/sitemap">Sitemap</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Questions or ideas?</h3>
        <p class="update-text">Tell us which tool would save you time, or report a problem.</p>
        <a href="/contact" class="footer-contact-link">Contact us &rarr;</a>
        <div class="privacy-note">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-yellow)" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          We respect your privacy. No tool input is ever collected.
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} idoconverter. All rights reserved.</p>
      <div class="footer-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/sitemap">Sitemap</a>
      </div>
    </div>
    
  </div>
</footer>

<style>
  .footer {
    background-color: var(--color-bg-dark);
    padding: var(--space-7) 0 var(--space-5) 0;
    margin-top: auto;
    color: var(--color-text-light);
  }
  
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  /* Footer Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr 1.5fr 1.5fr 1fr 1.5fr;
      gap: var(--space-5);
    }
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--color-text-light);
    text-decoration: none;
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }
  
  .logo-icon {
    color: var(--color-text-light);
    fill: rgba(255, 255, 255, 0.1);
  }
  
  .brand-tagline {
    font-size: 1rem;
    margin-bottom: var(--space-2);
    color: var(--color-text-light);
  }
  
  .brand-desc {
    color: #A7C5B8;
    font-size: 0.85rem;
    line-height: 1.6;
    margin-bottom: var(--space-5);
    max-width: 300px;
  }
  
  .social-links {
    display: flex;
    gap: var(--space-3);
  }
  
  .social-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--color-text-light);
    transition: all 0.2s ease;
  }
  
  .social-links a:hover {
    background: rgba(255,255,255,0.1);
  }

  .col-title {
    color: var(--color-text-light);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: var(--space-4);
  }

  .col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .col-links a {
    color: #A7C5B8;
    font-size: 0.85rem;
    text-decoration: none;
    font-weight: 400;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: color 0.2s ease;
  }

  .col-links a:hover {
    color: var(--color-text-light);
  }
  
  .link-icon {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }
  
  /* Unbuilt tools stay listed but not clickable, so there are no dead links */
  .soon-link {
    color: #A7C5B8;
    font-size: 0.85rem;
  }

  .col-links a.disabled {
    opacity: 0.5;
    pointer-events: none;
  }
  
  .badge {
    background: rgba(242, 201, 76, 0.15);
    color: var(--color-accent-yellow);
    font-size: 0.65rem;
    padding: 2px 6px;
    border-radius: 4px;
    margin-left: auto;
  }

  /* Get Updates Column */
  .update-text {
    font-size: 0.85rem;
    color: #A7C5B8;
    margin-bottom: var(--space-3);
  }
  
  .footer-contact-link {
    display: inline-block;
    color: var(--color-accent-yellow);
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: var(--space-3);
  }
  .footer-contact-link:hover { color: var(--color-text-light); }

  
  
  
  .privacy-note {
    font-size: 0.7rem;
    color: rgba(167, 197, 184, 0.7);
    display: flex;
    align-items: flex-start;
    gap: 6px;
    line-height: 1.4;
  }

  /* Bottom Bar */
  .footer-bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: var(--space-5);
    text-align: center;
  }
  
  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .footer-bottom p {
    color: #A7C5B8;
    font-size: 0.75rem;
    margin: 0;
  }
  
  .footer-links {
    display: flex;
    gap: var(--space-4);
  }
  
  .footer-links a {
    color: #A7C5B8;
    font-size: 0.75rem;
    text-decoration: none;
  }
  
  .footer-links a:hover {
    color: white;
  }
</style>
