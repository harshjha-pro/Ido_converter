---
import Layout from '../layouts/Layout.astro';
import { TOOLS, type Profession } from '../data/tools';

// Badges show live tools only, so the home page never promises tools that do not exist yet.
function badge(p: Profession): string {
  const n = TOOLS.filter(t => t.profession === p && t.live).length;
  return n === 0 ? 'Coming soon' : `${n} tool${n === 1 ? '' : 's'}`;
}
---

<Layout title="Home">
