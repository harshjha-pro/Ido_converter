            <li><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> Saved history</li>
            <li><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg> More features (TBD)</li>
          </ul>
          <div class="p-btn-area"><span class="btn-outline disabled-plan">Coming Soon</span></div>
        </div>

        <div class="p-card">
