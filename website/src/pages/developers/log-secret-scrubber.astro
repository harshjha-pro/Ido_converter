---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  slug="log-secret-scrubber"
  howTo="Paste logs, config or stack traces. API keys, tokens, JWTs, passwords, connection-string passwords and private key blocks are replaced with [REDACTED:type]. Check the findings list, review the output, then copy it."
  faq={[
    { q: "Is my log sent anywhere?", a: "No. Scrubbing runs entirely in your browser. Nothing is uploaded, stored or logged." },
    { q: "Can it miss secrets?", a: "Yes. It is pattern-based, so a secret in an unusual format can slip through, and some harmless values may be redacted. Always read the output before you share it." },
    { q: "What does it detect?", a: "Private key blocks, passwords in connection strings, JWTs, AWS, GitHub, Slack, Stripe and Google keys, sk- style API keys, Bearer and Basic auth headers, and values of keys such as password, secret, token and api_key." },
    { q: "Why does the findings list not show the secrets?", a: "So the list itself is safe to screenshot or paste. It shows the type, the count and the line numbers to check." }
  ]}
>
  <div class="tool-ui">
    <p class="tool-warning"><strong>Review before sharing.</strong> This tool is pattern-based and can miss secrets in unusual formats.</p>
    <div class="panels two-col">
      <div class="panel">
        <label for="input-log" class="panel-label">Logs or text</label>
        <textarea id="input-log" class="io-area" spellcheck="false" placeholder="2026-10-01 DEBUG DATABASE_URL=postgres://admin:secret@db:5432/app"></textarea>
        <button id="btn-run" class="btn-primary btn-run">Scrub secrets &rarr;</button>
        <div id="status-area" class="status-area" role="status"></div>
      </div>
      <div class="panel">
        <div class="panel-header">
          <label for="output-log" class="panel-label">Scrubbed output</label>
          <button id="btn-copy" class="btn-secondary">Copy output</button>
        </div>
        <textarea id="output-log" class="io-area" readonly spellcheck="false"></textarea>
      </div>
    </div>
    <section class="result-box" aria-labelledby="findings-title">
      <h2 id="findings-title" class="panel-label">Findings</h2>
      <ul id="findings" class="findings-list"><li>Nothing scrubbed yet.</li></ul>
    </section>
  </div>
</ToolLayout>

<script>
  import { run, type Finding } from '../../../../core/developers/secret-scrubber';
  import { byId, setStatus, setupCopy, isLargeInput } from '../../scripts/tool-ui';

  const inputEl = byId<HTMLTextAreaElement>('input-log');
  const outputEl = byId<HTMLTextAreaElement>('output-log');
  const statusEl = byId<HTMLDivElement>('status-area');
  const findingsEl = byId<HTMLUListElement>('findings');

  function renderFindings(findings: Finding[]) {
    findingsEl.replaceChildren();
    if (findings.length === 0) {
      const li = document.createElement('li');
      li.textContent = 'No known secret patterns found. That does not prove the text is safe; please review it.';
      findingsEl.append(li);
      return;
    }
    for (const f of findings) {
      const li = document.createElement('li');
      const lines = f.lines.length > 10 ? `${f.lines.slice(0, 10).join(', ')} and more` : f.lines.join(', ');
      li.textContent = `${f.label}: ${f.count} (line${f.lines.length > 1 ? 's' : ''} ${lines})`;
      findingsEl.append(li);
    }
  }

  byId<HTMLButtonElement>('btn-run').addEventListener('click', () => {
    const input = inputEl.value;
    const result = run(input);
    if (!result.ok) {
      outputEl.value = '';
      renderFindings([]);
      setStatus(statusEl, `Error: ${result.error}`, 'error');
      return;
    }
    outputEl.value = result.output ?? '';
    renderFindings(result.meta?.findings as Finding[]);
    setStatus(statusEl,
      `Redacted ${result.meta?.total ?? 0} secrets. Review before sharing.`
        + (isLargeInput(input) ? ' Large input: processing may be slow on some devices.' : ''),
      'success');
  });

  setupCopy(byId<HTMLButtonElement>('btn-copy'), outputEl);
</script>
