---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Tools for Developers">
  <div class="page-header">
    <h1>Tools for <span class="font-serif-italic">Developers</span></h1>
    <p class="subtitle">Need to transform, clean and safely share data? These tools run entirely in your browser to protect your sensitive payloads.</p>
  </div>
  
  <div class="tool-list">
    <div class="tool-card">
      <div class="tool-info">
        <h2>JSON PII Masker</h2>
        <p>Mask sensitive values by key name and by pattern while keeping valid JSON structure.</p>
      </div>
      <div class="tool-action">
        <a href="/developers/json-pii-masker" class="btn-primary">Open Tool</a>
      </div>
    </div>
    
    <!-- Future tools go here, matching the identical card layout above -->
  </div>
</Layout>

<style>
  .page-header {
    margin-bottom: var(--space-7);
    max-width: 800px;
  }
  
  .page-header h1 {
    font-size: 3rem;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    color: var(--color-bg-dark);
  }
  
  .subtitle {
    font-size: var(--text-h3);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  
  .tool-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  
  .tool-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-card-bg);
    padding: var(--space-5);
    border-radius: 24px;
    border: 1px solid rgba(0,0,0,0.05);
    box-shadow: 0 4px 20px rgba(0,0,0,0.03);
    gap: var(--space-4);
  }
  
  @media (min-width: 600px) {
    .tool-card {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: var(--space-5) var(--space-6);
    }
  }
  
  .tool-info {
    flex: 1;
  }
  
  .tool-info h2 {
    margin-bottom: var(--space-2);
    color: var(--color-bg-dark);
  }
  
  .tool-info p {
    color: var(--color-text-muted);
    margin-bottom: 0;
    max-width: 600px;
    font-size: var(--text-body);
  }
  
  .tool-action {
    flex-shrink: 0;
  }
  
  /* On mobile, ensure button is full width */
  @media (max-width: 599px) {
    .tool-action .btn-primary {
      width: 100%;
      text-align: center;
    }
  }
</style>
