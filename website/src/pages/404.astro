---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" noindex>
  <div class="not-found">
    <h1>Page not <span class="font-serif-italic">found</span></h1>
    <p>That page does not exist, or it has moved.</p>
    <a href="/" class="btn-primary">Go to the home page &rarr;</a>
    <p class="hint">Or browse the <a href="/sitemap/">sitemap</a>.</p>
  </div>
</Layout>

<style>
  .not-found { max-width: 600px; margin: 0 auto; text-align: center; }
  .not-found h1 { color: var(--color-bg-dark); }
  .hint { margin-top: var(--space-4); font-size: var(--text-small); color: var(--color-text-muted); }
</style>
